# ══════════════════════════════════════════════════════════════════════════════
#  docker compose 的环境变量模板
# ══════════════════════════════════════════════════════════════════════════════
#
#  用法：cp .env.example .env，然后把每一处的 replace-with-... 换成真实值。
#  .env 已被 .gitignore 忽略（.env.example 例外保留），可以放心填密钥。
#
#  ⚠ 下面所有值都刻意以 "replace-" 开头，这不是偷懒 ——
#    ProductionReadinessValidator 会拒绝含 "replace-" 或 "changeme" 的值。
#    也就是说：复制了模板却忘了改，进程会在启动时明确报
#      "DB_PASSWORD still contains a placeholder value"
#    而不是带着一把可预测的弱密钥静默跑起来。
#
#  为什么变量名是这些：validator（@Profile("prod")）读的是**环境变量名**本身，
#  不是 spring.datasource.*。只有 application-prod.yml 里显式写成 ${DB_URL:...}
#  的几项两者才指向同一个值。用 SPRING_DATASOURCE_URL 代替 DB_URL 会让
#  数据源连得上、断言却照旧报 "DB_URL is required" —— 一半能配、一半不能配。
#
# ── 必需：数据库 ──────────────────────────────────────────────────────────────
#  DB_URL / DB_USERNAME / DB_PASSWORD 三项同时喂给数据源和断言。
DB_URL=jdbc:mysql://mysql:3306/mini_agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
# 建议改为非 root 的应用账号：应用只需要 mini_agent 库的读写权限。
# 沿用 root 时，一次注错库名/误删的代价就是整实例。
DB_USERNAME=root
# 下面两个必须同值：MYSQL_ROOT_PASSWORD 是 mysql 容器初始化 root 用的，
# DB_PASSWORD 是 app 连库用的。不一致的症状是 app 反复重启、日志里
# "Access denied for user 'root'"，而 mysql 容器本身是 healthy 的。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-db-password
DB_PASSWORD=replace-with-a-strong-db-password

# ── 必需：Redis ───────────────────────────────────────────────────────────────
# 这一个变量同时用于：redis 容器的 --requirepass、它的 healthcheck、
# 以及 app 的 spring.data.redis.password。三处必须同源，所以只写一次。
REDIS_PASSWORD=replace-with-a-strong-redis-password

# ── 必需：Milvus 的对象存储（MinIO） ──────────────────────────────────────────
# 刻意不给 minioadmin/minioadmin 这类出厂值：任何扫描器都会先试它。
# docker-compose 里用 ${MINIO_ACCESS_KEY:?} 强制要求显式提供。
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# ── 必需：对话模型 ────────────────────────────────────────────────────────────
# 缺失会被断言拦住。不拦的话进程能起来却无法对话，那种故障排查成本很高。
LLM_API_KEY=replace-with-your-llm-api-key

# ── 必需：跨域白名单 ──────────────────────────────────────────────────────────
# 每一项必须是精确的 HTTPS origin：不能带 path、query、片段或 user:pass@。
# 本地自测可用 https://localhost；上生产必须换成真实域名。
ALLOWED_ORIGINS=replace-with-https-your-domain

# ── 必需：模型配置加密密钥 ────────────────────────────────────────────────────
# 必须 Base64 解码后正好 32 字节。生成：openssl rand -base64 32
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# ── 必需：JWT 签名密钥 ────────────────────────────────────────────────────────
# HS256，UTF-8 字节数 >= 32。生成：openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48

# ── 必需：app ↔ account 的服务间密钥 ─────────────────────────────────────────
# 两个服务读的是同一个变量名（刻意如此，避免"改了一个忘了另一个"）。
# 留空时服务照常启动，但会员接口返回 503 —— 这是刻意的：
# 放行等于把所有人的会员与订单数据暴露给任何能访问该端口的人。
ACCOUNT_INTERNAL_KEY=replace-with-a-shared-internal-key

# ── 可选 ──────────────────────────────────────────────────────────────────────
# 账号服务地址。默认 http://account:8081，一般不用改。
# ACCOUNT_BASE_URL=http://account:8081
#
# 引导管理员。两个都填才会生效，且密码 >= 16 字符、不能是占位值。
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
