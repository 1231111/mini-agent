# MiniAgent host deployment environment template.
# Copy to .env, replace every placeholder, and keep the file out of version control.
# Services are expected to run behind a private network and TLS reverse proxy.

# Dedicated application database account. Do not use MySQL root for services.
DB_PASSWORD=replace-with-a-strong-db-password
DB_URL=jdbc:mysql://127.0.0.1:3306/mini_agent?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=miniagent
MEMORY_SERVICE_DB_URL=jdbc:mysql://127.0.0.1:3306/mini_agent_memory?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8

# Redis must require this password and bind to a private interface.
REDIS_PASSWORD=replace-with-a-strong-redis-password

# App model/configuration credentials.
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
LLM_API_KEY=replace-with-your-llm-api-key

# Shared service credentials. Account and memory-service must use the same values.
ACCOUNT_INTERNAL_KEY=replace-with-a-random-64-character-key
ACCOUNT_MEMORY_TOKEN_KEY=replace-with-base64-encoded-32-random-bytes
JWT_SECRET=replace-with-base64-encoded-48-random-bytes
ACCOUNT_BASE_URL=http://127.0.0.1:8081

# Self-hosted quota defaults (override after capacity planning).
AGENT_SELF_HOSTED_DAILY_TOKEN_LIMIT=1000000
AGENT_SELF_HOSTED_DAILY_USER_TOKEN_LIMIT=100000

# Release/deployment gates.
# MODELS_ARCHIVE_SHA256 is supplied as a protected CI secret, not committed here.
# MIGRATION_BACKUP_VERIFIED=true and MIGRATION_BACKUP_ID are required by the release gate.
