[Unit]
Description=MiniAgent memory service
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=miniagent
Group=miniagent
WorkingDirectory=/opt/miniagent
EnvironmentFile=/etc/miniagent/memory-service.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=60 -XX:InitialRAMPercentage=20 -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError -jar /opt/miniagent/mini-agent-memory-service/target/mini-agent-memory-service-0.0.1-SNAPSHOT.jar --spring.profiles.active=prod --server.address=127.0.0.1 --server.port=8091
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM
SuccessExitStatus=143
MemoryMax=1G
CPUQuota=100%
TasksMax=256
LimitNOFILE=32768
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/miniagent /var/log/miniagent

[Install]
WantedBy=multi-user.target
