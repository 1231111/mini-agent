<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miniagent</groupId>
        <artifactId>mini-agent-springboot</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mini-agent-account</artifactId>
    <name>mini-agent-account</name>
    <description>云端账号服务：登录、注册、会员等级与充值</description>
    <packaging>jar</packaging>

    <dependencies>
        <!--
          只为了 ApiResponse 与 ErrorCode 两个类。
          为什么不用复制代替：它们是本服务与调用方之间的线上契约 —— 错误码一旦在两边
          各存一份，AUTH.01.01 这类码迟早会漂移，而漂移的后果是"密码错"被显示成"网络错"。

          代价要说清楚：common 目前不是纯基础件，它带着 onnxruntime(92MB)、
          tokenizers(18MB)、milvus-sdk-java。账号服务一个都用不到。
          修法是抽一个只含契约类的小模块出来，但那会动到 common 的包结构、
          波及全部 6 个模块，属于独立一轮的事。见 README 的「待办」。
        -->
        <dependency>
            <groupId>com.miniagent</groupId>
            <artifactId>mini-agent-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          只用 BCryptPasswordEncoder，刻意不引 spring-boot-starter-security：
          那会拉起整条过滤链，而账号服务没有自己的浏览器会话（按设计不签 token），
          用不上它。密码哈希是这个服务唯一的 security 需求。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 本地与联调用；prod 档走 MySQL。两个驱动并存不冲突，由 spring.datasource 显式指定。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.miniagent.account.AccountApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
